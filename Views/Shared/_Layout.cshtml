@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
@{
    var currentNickName = HttpContextAccessor.HttpContext?.Session.GetString("NickName");
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Anonim</title>
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-surface">
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark-glass sticky-top py-3">
            <div class="container">
                <a class="navbar-brand fw-extrabold d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
                    <span class="brand-badge"><i class="bi bi-incognito"></i></span>
                    <span class="brand-text">ANONİM</span>
                </a>
                <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar" aria-controls="mainNavbar" aria-expanded="false" aria-label="Menüyü Aç/Kapat">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNavbar">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-3 gap-1">
                        <li class="nav-item">
                            <a class="nav-link px-3 rounded-pill" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house-door-fill me-1"></i> Keşfet
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-3 rounded-pill" asp-controller="Itiraf" asp-action="Index">
                                <i class="bi bi-mask me-1"></i> İtiraflar
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-3 rounded-pill" asp-controller="Hikaye" asp-action="Index">
                                <i class="bi bi-book-half me-1"></i> Hikayeler
                            </a>
                        </li>
                    </ul>

                    <!-- Kullanıcı Durumu / Giriş & Çıkış -->
                    <div class="d-flex align-items-center gap-2">
                        @if (!string.IsNullOrEmpty(currentNickName))
                        {
                            <div class="dropdown">
                                <button class="btn btn-outline-light dropdown-toggle rounded-pill px-3 py-2 d-flex align-items-center gap-2" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <div class="avatar-sm-circle">@currentNickName.Substring(0, 1).ToUpper()</div>
                                    <span class="fw-semibold">@currentNickName</span>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0 rounded-4 mt-2">
                                    <li><h6 class="dropdown-header">Anonim Profil</h6></li>
                                    <li>
                                        <a class="dropdown-item py-2" asp-controller="Itiraf" asp-action="Create">
                                            <i class="bi bi-plus-circle me-2 text-primary"></i>İtiraf Paylaş
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item py-2" asp-controller="Hikaye" asp-action="Create">
                                            <i class="bi bi-pencil-square me-2 text-info"></i>Hikaye Yaz
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <a class="dropdown-item text-danger py-2" asp-controller="User" asp-action="Logout">
                                            <i class="bi bi-box-arrow-right me-2"></i>Çıkış Yap
                                        </a>
                                    </li>
                                </ul>
                            </div>
                        }
                        else
                        {
                            <a class="btn btn-ghost text-light rounded-pill px-3" asp-controller="User" asp-action="Login">
                                Giriş Yap
                            </a>
                            <a class="btn btn-primary rounded-pill px-4 shadow-sm" asp-controller="User" asp-action="Register">
                                Kayıt Ol
                            </a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <!-- Ana İçerik -->
    <main role="main" class="pb-5 min-vh-80">
        @RenderBody()
    </main>

    <footer class="footer bg-dark-glass text-light py-4 border-top border-secondary-subtle">
        <div class="container text-center text-md-between d-flex flex-column flex-md-row justify-content-between align-items-center gap-3">
            <div class="small text-secondary">
                &copy; 2026 <strong>Anonim</strong>. Tüm düşünceler gizlidir, kimlikler koruma altındadır.
            </div>
            <div class="d-flex gap-3 text-secondary small">
                <a asp-controller="Home" asp-action="Index" class="text-secondary text-decoration-none">Ana Sayfa</a>
                <span>•</span>
                <a asp-controller="Itiraf" asp-action="Index" class="text-secondary text-decoration-none">İtiraflar</a>
                <span>•</span>
                <a asp-controller="Hikaye" asp-action="Index" class="text-secondary text-decoration-none">Hikayeler</a>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
