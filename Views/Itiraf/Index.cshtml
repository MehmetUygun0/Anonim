@model IEnumerable<Anonim.Models.Itiraf>
@inject IHttpContextAccessor HttpContextAccessor
@{
    ViewData["Title"] = "İtiraflar";
    var currentUserId = HttpContextAccessor.HttpContext?.Session.GetInt32("UserId");
    var totalCount = Model?.Count() ?? 0;
}

<div class="container py-4">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
        <div>
            <h1 class="h2 fw-bold mb-1 text-gradient">
                <i class="bi bi-mask me-2"></i>Gizli İtiraflar
            </h1>
            <p class="text-muted mb-0">Kimliğini açıklamadan içini dök.</p>
        </div>
        <div class="d-flex gap-2">
            @if (currentUserId != null)
            {
                <a asp-action="Create" class="btn btn-primary rounded-pill px-4 shadow-sm">
                    <i class="bi bi-plus-circle me-1"></i> Yeni İtiraf Paylaş
                </a>
            }
            else
            {
                <a asp-controller="User" asp-action="Login" class="btn btn-outline-primary rounded-pill px-4 shadow-sm">
                    <i class="bi bi-box-arrow-in-right me-1"></i> Paylaşmak İçin Giriş Yap
                </a>
            }
        </div>
    </div>

    <!-- Dinamik Razor İstatistik Kartları -->
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-md-4">
            <div class="card stat-card shadow-sm border-0 rounded-4">
                <div class="card-body d-flex align-items-center">
                    <div class="stat-icon bg-primary-subtle text-primary rounded-3 p-3 me-3">
                        <i class="bi bi-chat-heart-fill fs-4"></i>
                    </div>
                    <div>
                        <span class="text-muted small fw-medium">Toplam İtiraf</span>
                        <h4 class="fw-bold mb-0">@totalCount</h4>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-md-4">
            <div class="card stat-card shadow-sm border-0 rounded-4">
                <div class="card-body d-flex align-items-center">
                    <div class="stat-icon bg-warning-subtle text-warning rounded-3 p-3 me-3">
                        <i class="bi bi-fire fs-4"></i>
                    </div>
                    <div>
                        <span class="text-muted small fw-medium">Bugün Eklenenler</span>
                        @{
                            var todayCount = Model?.Count(x => x.CreatedAt.Date == DateTime.Today) ?? 0;
                        }
                        <h4 class="fw-bold mb-0">@todayCount</h4>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-sm-12 col-md-4">
            <div class="card stat-card shadow-sm border-0 rounded-4">
                <div class="card-body d-flex align-items-center">
                    <div class="stat-icon bg-success-subtle text-success rounded-3 p-3 me-3">
                        <i class="bi bi-person-check-fill fs-4"></i>
                    </div>
                    <div>
                        <span class="text-muted small fw-medium">Senin İtirafların</span>
                        @{
                            var myCount = currentUserId != null ? (Model?.Count(x => x.UserId == currentUserId) ?? 0) : 0;
                        }
                        <h4 class="fw-bold mb-0">@myCount</h4>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Arama Formu (300ms Debounce ile Otomatik Arama) -->
    <div class="card border-0 shadow-sm rounded-4 mb-4 glass-card">
        <div class="card-body p-3">
            <form id="searchForm" asp-action="Index" method="get" class="row g-2 align-items-center">
                <div class="col-12 d-flex align-items-center">
                    <div class="input-group">
                        <span class="input-group-text bg-transparent border-0"><i class="bi bi-search"></i></span>
                        <input type="text" id="searchInput" name="search" value="@ViewBag.Search" class="form-control border-0 bg-transparent" placeholder="Yazmaya başladığınız an aranır (başlık veya içerik)..." autocomplete="off" />
                        @if (!string.IsNullOrEmpty(ViewBag.Search as string))
                        {
                            <a asp-action="Index" class="btn btn-sm btn-outline-secondary rounded-pill my-auto me-2">Temizle</a>
                        }
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Dinamik Liste / Boş Durum -->
    @if (Model == null || !Model.Any())
    {
        <div class="text-center py-5">
            <div class="empty-state-icon mb-3">
                <i class="bi bi-chat-square-dots text-muted fs-1"></i>
            </div>
            <h4 class="fw-semibold text-muted">Henüz itiraf bulunamadı</h4>
            <p class="text-muted small">İlk itirafı paylaşan sen olmak ister misin?</p>
            @if (currentUserId != null)
            {
                <a asp-action="Create" class="btn btn-primary rounded-pill px-4 mt-2">İlk İtirafı Yap</a>
            }
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var item in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 itiraf-card shadow-sm border-0 rounded-4">
                        <div class="card-body d-flex flex-column p-4">
                            <!-- Kart Başlık & Anonim Yazar -->
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <div class="d-flex align-items-center gap-2">
                                    <div class="avatar-sm">
                                        <i class="bi bi-incognito"></i>
                                    </div>
                                    <div>
                                        <span class="badge bg-light text-dark fw-bold border">
                                            @(item.User?.NickName ?? "Anonim")
                                        </span>
                                    </div>
                                </div>
                                <span class="text-muted extra-small">
                                    <i class="bi bi-clock me-1"></i>@item.CreatedAt.ToString("dd MMM yyyy, HH:mm")
                                </span>
                            </div>

                            <h5 class="card-title fw-bold text-dark mb-2">@item.Title</h5>
                            <p class="card-text text-secondary flex-grow-1 itiraf-text">@item.Text</p>

                            <!-- Alt İşlem Butonları -->
                            <div class="d-flex justify-content-between align-items-center mt-3 pt-3 border-top">
                                <div class="d-flex align-items-center gap-2">
                                    <span class="badge bg-secondary-subtle text-secondary rounded-pill">
                                        #@item.Id
                                    </span>
                                    <span class="badge bg-danger-subtle text-danger rounded-pill">
                                        <i class="bi bi-heart-fill me-1"></i>@item.LikeCount
                                    </span>
                                </div>

                                @if (currentUserId != null && item.UserId == currentUserId)
                                {
                                    <form asp-action="Delete" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Bu itirafı silmek istediğine emin misin?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3">
                                            <i class="bi bi-trash-fill me-1"></i>Sil
                                        </button>
                                    </form>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const searchInput = document.getElementById("searchInput");
            const searchForm = document.getElementById("searchForm");
            let debounceTimer;

            if (searchInput) {
                // Sayfa yenilendiğinde imleci input'un sonuna konumlandır
                if (searchInput.value) {
                    searchInput.focus();
                    const val = searchInput.value;
                    searchInput.value = '';
                    searchInput.value = val;
                }

                searchInput.addEventListener("input", function () {
                    clearTimeout(debounceTimer);
                    debounceTimer = setTimeout(function () {
                        searchForm.submit();
                    }, 300); // 0.3 saniye bekleme
                });
            }
        });
    </script>
}
