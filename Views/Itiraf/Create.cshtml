@model Anonim.Models.Itiraf
@{
    ViewData["Title"] = "Yeni İtiraf Paylaş";
}

<div class="row justify-content-center py-4">
    <div class="col-md-7 col-lg-6">
        <div class="card shadow-lg border-0 rounded-4 glass-card">
            <div class="card-body p-4 p-md-5">
                <div class="mb-4">
                    <a asp-action="Index" class="text-decoration-none text-muted small mb-2 d-inline-block">
                        <i class="bi bi-arrow-left me-1"></i> İtiraflara Geri Dön
                    </a>
                    <h2 class="fw-bold text-gradient">İtirafını Paylaş</h2>
                    <p class="text-muted small">Kimse senin kim olduğunu bilmeyecek. Sadece anonim takma adın görünecek.</p>
                </div>

                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label asp-for="Title" class="form-label fw-semibold">Başlık</label>
                        <input asp-for="Title" class="form-control bg-light border-0 py-2 rounded-3" placeholder="Örn: Kimseye anlatamadığım o gün..." required />
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Text" class="form-label fw-semibold">İtiraf İçeriği</label>
                        <textarea asp-for="Text" class="form-control bg-light border-0 py-2 rounded-3" rows="6" placeholder="İçini dök, dilediğin gibi anlat..." required></textarea>
                        <span asp-validation-for="Text" class="text-danger small"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary flex-grow-1 py-2 rounded-3 fw-bold shadow-sm">
                            <i class="bi bi-send-fill me-1"></i> Yayınla
                        </button>
                        <a asp-action="Index" class="btn btn-light py-2 rounded-3">İptal</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
